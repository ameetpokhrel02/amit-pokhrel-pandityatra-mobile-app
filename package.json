{
  "name": "pandityatra-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start",
    "start:tunnel": "expo start --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:critical": "jest --testPathPattern='(auth|booking|kundali)' --verbose",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
